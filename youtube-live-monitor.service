[Unit]
Description=YouTube Live Monitor (exporter para VictoriaMetrics/Prometheus)
Documentation=file:///usr/share/doc/youtube-live-monitor/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youtube-monitor
Group=youtube-monitor
EnvironmentFile=-/etc/youtube-live-monitor/environment
ExecStart=/opt/youtube-live-monitor/venv/bin/python /opt/youtube-live-monitor/youtube_live_monitor.py --config /etc/youtube-live-monitor/config.yaml --database /var/lib/youtube-live-monitor/state.db
Restart=on-failure
RestartSec=10
WorkingDirectory=/var/lib/youtube-live-monitor
StateDirectory=youtube-live-monitor
StateDirectoryMode=0750
ConfigurationDirectory=youtube-live-monitor
ConfigurationDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
ReadWritePaths=/var/lib/youtube-live-monitor
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
